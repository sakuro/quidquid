amends "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Builtins.pkl"
import "package://github.com/sakuro/git-hooks/releases/download/v0.1.2/git-hooks@0.1.2#/Steps.pkl" as GitHooks

hooks {
  ["commit-msg"] {
    steps {
      ["emoji-enforced"] = GitHooks.emoji_enforced
    }
  }
  ["prepare-commit-msg"] {
    steps {
      ["merge-prefix"] = GitHooks.merge_prefix
    }
  }
  ["pre-commit"] {
    steps {
      ["gitleaks"] = Builtins.gitleaks
      ["no-commit-to-branch"] = Builtins.no_commit_to_branch
      ["stylua"] {
        glob = "**/*.lua"
        check = "stylua --check {{files}} || { echo 'Lua formatting check failed. Run `mise run format`, then stage the changes and commit again.' >&2; exit 1; }"
      }
    }
  }
  ["pre-push"] {
    steps {
      ["case-conflict"] = Builtins.check_case_conflict
      ["newlines"] = Builtins.newlines
    }
  }
}
